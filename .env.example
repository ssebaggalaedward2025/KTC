APP_NAME="KTC BPTMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Argon2id in all environments (tests override with bcrypt for speed).
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Docker Compose values. For a quick local run without Docker use DB_CONNECTION=sqlite.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bptms
DB_USERNAME=bptms
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Idle session timeout (minutes). HTTPS-only cookies outside local.
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bptms@kyengeratc.go.ug"
MAIL_FROM_NAME="${APP_NAME}"

# --- BPTMS ---
BPTMS_IDLE_TIMEOUT=30
BPTMS_SEED_DEMO_USERS=true
BPTMS_DEADLINE_DAY_TYPE=working
BPTMS_UPLOAD_MAX_KB=51200
# null (dev only) | clamav
BPTMS_SCANNER=null
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
BPTMS_SMS_DRIVER=log
# turnstile | none
BPTMS_CAPTCHA=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Backups (spatie/laravel-backup): archive encryption password
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
